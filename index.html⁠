<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>한규서의 스마트폰</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: #0d0d0d;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: #fff;
        }

        .phone-container {
            width: 360px;
            height: 740px;
            background: #1c1c1e;
            border-radius: 40px;
            border: 12px solid #2c2c2e;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
            display: flex;
            flex-direction: column;
        }

        /* Status Bar */
        .status-bar {
            height: 35px;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            font-weight: 600;
            z-index: 10;
        }

        /* Lock Screen */
        .screen {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 40px 20px 20px;
            background: linear-gradient(180deg, #1f2937 0%, #111827 100%);
            position: relative;
        }

        .clock-container {
            text-align: center;
            margin-top: 20px;
        }

        .date {
            font-size: 16px;
            color: #9ca3af;
            font-weight: 500;
        }

        .time {
            font-size: 64px;
            font-weight: 200;
            letter-spacing: -2px;
            margin-top: 5px;
        }

        .notification {
            width: 100%;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 15px;
            margin-top: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            cursor: pointer;
            transition: transform 0.2s;
        }

        .notification:active {
            transform: scale(0.98);
        }

        .noti-header {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #9ca3af;
            margin-bottom: 6px;
        }

        .noti-title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .noti-body {
            font-size: 13px;
            color: #d1d5db;
        }

        .unlock-btn {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: white;
            padding: 12px 24px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            backdrop-filter: blur(5px);
            margin-bottom: 20px;
        }

        .unlock-btn:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        /* Home Screen (App Grid) */
        .home-screen {
            display: none;
            flex: 1;
            padding: 30px 20px;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            align-content: start;
            background: #000;
        }

        .app-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        .icon-box {
            width: 58px;
            height: 58px;
            border-radius: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
        }

        .app-name {
            font-size: 11px;
            color: #ccc;
        }

        /* Modal Overlay */
        .modal {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 100;
            padding: 40px 20px;
            flex-direction: column;
            justify-content: center;
        }

        .modal-card {
            background: #2c2c2e;
            border-radius: 20px;
            padding: 20px;
            border: 1px solid #3a3a3c;
        }

        .modal-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 12px;
            color: #60a5fa;
        }

        .modal-content {
            font-size: 14px;
            line-height: 1.6;
            color: #e5e7eb;
            white-space: pre-line;
        }

        .close-btn {
            margin-top: 15px;
            width: 100%;
            padding: 10px;
            background: #3b82f6;
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>
<body>

<div class="phone-container">
    <!-- Status Bar -->
    <div class="status-bar">
        <span>09:10</span>
        <span>LTE 100%</span>
    </div>

    <!-- Lock Screen -->
    <div class="screen" id="lockScreen">
        <div class="clock-container">
            <div class="date">9월 10일 목요일</div>
            <div class="time">09:10</div>
        </div>

        <div class="notification" onclick="openMemo('알림', '메모 앱에서 새로운 기록이 발견되었습니다.')">
            <div class="noti-header">
                <span>메모</span>
                <span>방금 전</span>
            </div>
            <div class="noti-title">🔒 비밀 메모</div>
            <div class="noti-body">절대로 아무에게도 말하지 말 것...</div>
        </div>

        <button class="unlock-btn" onclick="unlockPhone()">화면 터치하여 잠금해제</button>
    </div>

    <!-- Home Screen -->
    <div class="home-screen" id="homeScreen">
        <div class="app-icon" onclick="openMemo('갤러리', '📷 사진첩\n\n- 2009년 9월 10일 사진\n- 삭제된 사진 복구 파일 (1건)')">
            <div class="icon-box" style="background: #ef4444;">🖼️</div>
            <span class="app-name">갤러리</span>
        </div>
        <div class="app-icon" onclick="openMemo('메시지', '💬 최근 대화\n\n[쌍둥이]: 오늘 몇 시에 와?\n[한규서]: 거의 다 왔어.')">
            <div class="icon-box" style="background: #10b981;">💬</div>
            <span class="app-name">메시지</span>
        </div>
        <div class="app-icon" onclick="openMemo('비밀 메모', '📝 한규서의 일기\n\n내 생일은 9월 10일이다. 기억해야 한다. 그날무슨 일이 있었는지...')">
            <div class="icon-box" style="background: #f59e0b;">📝</div>
            <span class="app-name">메모장</span>
        </div>
        <div class="app-icon" onclick="openMemo('설정', '⚙️ 시스템 정보\n\n소유자: 한규서\n생년월일: 2009.09.10\n상태: 정상 작동 중')">
            <div class="icon-box" style="background: #6b7280;">⚙️</div>
            <span class="app-name">설정</span>
        </div>
    </div>

    <!-- Modal Popup -->
    <div class="modal" id="modal">
        <div class="modal-card">
            <div class="modal-title" id="modalTitle">제목</div>
            <div class="modal-content" id="modalContent">내용</div>
            <button class="close-btn" onclick="closeModal()">닫기</button>
        </div>
    </div>
</div>

<script>
    function unlockPhone() {
        document.getElementById('lockScreen').style.display = 'none';
        document.getElementById('homeScreen').style.display = 'grid';
    }

    function openMemo(title, content) {
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalContent').innerText = content;
        document.getElementById('modal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('modal').style.display = 'none';
    }
</script>

</body>
</html>
